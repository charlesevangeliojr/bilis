# Optional tuning for Apache hosts that permit these overrides.
# Do not use this profile on InfinityFree.

# 0 = unlimited at Apache layer, PHP app enforces 100 MB
LimitRequestBody 0

# Disable compression for speed payloads
SetEnv no-gzip 1
SetEnv dont-vary 1
<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI ^/api/ no-gzip dont-vary
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "ping\.php$">
        Header set Cache-Control "no-store"
    </FilesMatch>
    <FilesMatch "(download|upload)\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set X-Accel-Buffering "no"
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_value max_execution_time 60
    php_value max_input_time 60
    php_value memory_limit 256M
    php_value post_max_size 150M
    php_value upload_max_filesize 150M
    php_flag output_buffering Off
    php_flag zlib.output_compression Off
</IfModule>
